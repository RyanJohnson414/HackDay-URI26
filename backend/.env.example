# Copy to .env and set your own key. Never commit backend/.env.
GEMINI_API_KEY=
# Use the exact Gemma model identifier enabled for your API key.
GEMINI_MODEL=gemma-3-27b-it
# Kept separate from GEMINI_MODEL; this is only used for vector generation.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
DATABASE_URL=sqlite:///./knowledge_graph.db
